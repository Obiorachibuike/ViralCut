// ViralCut — Prisma schema
// PostgreSQL + pgvector. Enable the extension once with:
//   CREATE EXTENSION IF NOT EXISTS vector;
// (the `docker-compose.yml` postgres image ships pgvector, and the
//  `scripts/init-db.sql` bootstrap runs the CREATE EXTENSION for you.)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Auth / identity
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  /// bcrypt hash. Null for OAuth-only accounts.
  passwordHash  String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  usage         Usage[]
  subscription  Subscription?
  exports       Export[]
  socialAccounts SocialAccount[]
  publications  Publication[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Projects & videos
// ---------------------------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  /// Optional per-project overrides for the moment scoring weights.
  scoreWeights Json?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos Video[]

  @@index([userId, archivedAt])
  @@index([createdAt])
}

enum VideoStatus {
  PENDING
  UPLOADING
  UPLOADED
  PREPARING
  TRANSCRIBING
  DIARIZING
  SCENE_DETECTING
  ANALYZING
  FINDING_MOMENTS
  READY
  FAILED
}

enum AspectRatio {
  RATIO_9_16 @map("9:16")
  RATIO_1_1 @map("1:1")
  RATIO_16_9 @map("16:9")
  RATIO_4_5 @map("4:5")
}

model Video {
  id             String      @id @default(cuid())
  projectId      String
  userId         String
  title          String
  status         VideoStatus @default(PENDING)
  /// Human-readable stage detail, e.g. "Downloading from YouTube".
  statusMessage  String?
  /// R2 object key of the ingested source media.
  storageKey     String?
  storageBucket  String?
  durationMs     Int?
  width          Int?
  height         Int?
  fps            Float?
  codec          String?
  audioCodec     String?
  bitrate        Int?
  sizeBytes      BigInt?
  language       String?
  /// Free-form metadata (ffprobe format/stream dump, provider payload, ...).
  metadata       Json?
  thumbnailKey   String?
  audioKey       String?
  errorMessage   String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sources      VideoSource[]
  transcript   Transcript?
  speakers     Speaker[]
  scenes       Scene[]
  analysisJobs AnalysisJob[]
  moments      Moment[]
  clips        Clip[]
  jobs         Job[]

  @@index([projectId, createdAt])
  @@index([userId, status])
}

enum SourceKind {
  UPLOAD
  YOUTUBE
  TIKTOK
  FACEBOOK
  GENERIC
  /// Produced by a text-to-video model rather than ingested from a source.
  GENERATED
}

enum SourceState {
  RESOLVED
  DOWNLOADING
  DOWNLOADED
  REJECTED
  FAILED
}

/// One ingestion attempt for a video. A video may have several sources over
/// its lifetime (e.g. re-download after the original was deleted).
model VideoSource {
  id            String      @id @default(cuid())
  videoId       String
  kind          SourceKind
  state         SourceState @default(RESOLVED)
  /// The URL the user pasted, or "upload" for direct uploads.
  inputUrl      String?     @db.Text
  /// Canonical provider id, e.g. the YouTube video id.
  externalId    String?
  provider      String?
  providerTitle String?
  providerMeta  Json?
  /// Storage key of the downloaded media (mirrors Video.storageKey on success).
  storageKey    String?
  sizeBytes     BigInt?
  /// Set when the source was refused (private / DRM / paywalled / ToS-blocked).
  rejectionReason String?   @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([kind, state])
  @@index([provider, externalId])
  @@index([externalId])
}

// ---------------------------------------------------------------------------
// Transcript
// ---------------------------------------------------------------------------

model Transcript {
  id          String   @id @default(cuid())
  videoId     String   @unique
  language    String?
  /// faster-whisper model identifier used, e.g. "large-v3".
  model       String?
  fullText    String?  @db.Text
  wordCount   Int      @default(0)
  durationMs  Int?
  /// VAD / segmentation parameters, kept for reproducibility.
  settings    Json?
  srtKey      String?
  vttKey      String?
  jsonKey     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  video    Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  segments TranscriptSegment[]

  @@index([videoId])
}

model TranscriptSegment {
  id           String   @id @default(cuid())
  transcriptId String
  /// 0-based ordinal within the transcript.
  index        Int
  startMs      Int
  endMs        Int
  text         String   @db.Text
  /// 0..1 average token probability reported by the ASR model.
  confidence   Float?
  speakerId    String?
  sceneId      Int?
  /// Normalised 128-d rolling embedding used for semantic search + dedupe.
  //  Declared as Unsupported so the schema stays portable; the column is a
  //  real pgvector `vector(1536)` when the extension is available.
  embedding    Unsupported("vector(1536)")?
  /// Word-level timing used by the caption generator.
  words        Json?
  createdAt    DateTime @default(now())

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  speaker    Speaker?   @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([transcriptId, index])
  @@index([transcriptId, startMs, endMs])
  @@index([speakerId])
  @@index([sceneId])
}

model Speaker {
  id          String  @id @default(cuid())
  videoId     String
  /// Stable per-video label: "SPEAKER_00" -> display name "Speaker 1".
  label       String
  displayName String
  /// Centroid embedding from pyannote, stored for re-clustering.
  embedding   Json?
  /// Total speaking time in ms.
  totalMs     Int     @default(0)
  color       String?
  createdAt   DateTime @default(now())

  video    Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  segments TranscriptSegment[]
  moments  Moment[]

  @@unique([videoId, label])
  @@index([videoId])
}

/// Scene change detected by PySceneDetect. Kept as its own model so the moment
/// generator can score "visual quality" against real cut boundaries.
model Scene {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  index     Int
  startMs   Int
  endMs     Int
  /// Mean content-difference score at the cut (higher = harder cut).
  cutScore  Float?
  frames    Int?
  /// Storage key of the representative thumbnail extracted for this scene.
  thumbKey  String?
  createdAt DateTime @default(now())

  @@unique([videoId, index])
  @@index([videoId, startMs])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

enum JobState {
  QUEUED
  DOWNLOADING
  PROCESSING
  TRANSCRIBING
  ANALYZING
  FINDING_MOMENTS
  GENERATING_CLIPS
  RENDERING
  COMPLETED
  FAILED
}

enum JobType {
  INGEST_VIDEO
  EXTRACT_AUDIO
  TRANSCRIBE_VIDEO
  DIARIZE_SPEAKERS
  DETECT_SCENES
  ANALYZE_TRANSCRIPT
  GENERATE_MOMENTS
  RANK_MOMENTS
  GENERATE_CLIP
  TRACK_FACES
  RENDER_VIDEO
  GENERATE_BROLL
  GENERATE_TEXT_TO_VIDEO
  PUBLISH_CLIP
  CLEANUP
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  videoId     String?
  type        JobType
  state       JobState  @default(QUEUED)
  progress    Int       @default(0)
  /// Idempotency key: re-enqueueing the same key is a no-op.
  idempotencyKey String? @unique
  queue       String    @default("cpu")
  payload     Json?
  result      Json?
  error       String?   @db.Text
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  video  Video?      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  render RenderJob?
  analysis AnalysisJob?

  @@index([userId, state])
  @@index([videoId, type, state])
  @@index([state, createdAt])
}

/// Per-video pipeline record. One video can be re-analysed, producing several.
model AnalysisJob {
  id             String    @id @default(cuid())
  videoId        String
  jobId          String?   @unique
  state          JobState  @default(QUEUED)
  progress       Int       @default(0)
  /// Prompt/provider versions used — makes results reproducible.
  providerModel  String?
  promptVersion  String?
  scoreWeights   Json?
  candidateCount Int       @default(0)
  momentCount    Int       @default(0)
  stageLog       Json?
  error          String?   @db.Text
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  video   Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  moments Moment[]

  @@index([videoId, createdAt])
}

// ---------------------------------------------------------------------------
// Moments
// ---------------------------------------------------------------------------

enum MomentCategory {
  HOOK
  EMOTIONAL
  STORY
  EDUCATIONAL
  CONTROVERSIAL
  INSPIRATIONAL
  BUSINESS
  TECHNICAL
  SURPRISING
  FUNNY
}

model Moment {
  id            String           @id @default(cuid())
  videoId       String
  analysisJobId String?
  /// Rank within its analysis run, 1 = best.
  rank          Int
  title         String
  /// Suggested one-line description shown in the moment list.
  summary       String?          @db.Text
  /// Transcript text covered by this moment (denormalised for fast preview).
  transcriptExcerpt String?      @db.Text
  startMs       Int
  endMs         Int
  /// Context padding actually applied, in ms.
  padBeforeMs   Int              @default(0)
  padAfterMs    Int              @default(0)
  category      MomentCategory
  categories    MomentCategory[]
  tags          String[]
  hookScore     Float            @default(0)
  curiosityScore Float           @default(0)
  emotionScore  Float            @default(0)
  storyScore    Float            @default(0)
  valueScore    Float            @default(0)
  shareScore    Float            @default(0)
  standaloneScore Float          @default(0)
  visualScore   Float            @default(0)
  finalScore    Float            @default(0)
  /// Per-signal explanation, surfaced in the UI as "why this ranked".
  scoreReasons  Json?
  /// Semantic cluster id — moments sharing a cluster are near-duplicates.
  clusterId     String?
  isClusterBest Boolean          @default(true)
  /// Primary speaker during the moment, when diarization found one.
  speakerId     String?
  /// Face-track box hint (normalised 0..1) for the reframe step.
  speakerBox    Json?
  thumbKey      String?
  /// LLM output cache: 3 hook options / 3 title options.
  hookOptions   Json?
  titleOptions  Json?
  selected      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  analysisJob AnalysisJob? @relation(fields: [analysisJobId], references: [id], onDelete: SetNull)
  speaker     Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  clips       Clip[]

  @@index([videoId, rank])
  @@index([videoId, finalScore(sort: Desc)])
  @@index([videoId, category])
  @@index([clusterId])
  @@index([analysisJobId])
  @@index([speakerId])
}

// ---------------------------------------------------------------------------
// Clips, captions, renders, exports
// ---------------------------------------------------------------------------

enum ReframeMode {
  AUTO
  CENTER
  SPEAKER_TRACK
  SPLIT_SCREEN
}

enum CaptionStyle {
  MINIMAL
  BOLD
  KARAOKE
  CREATOR
  PODCAST
  HIGH_IMPACT
}

enum ClipStatus {
  DRAFT
  PREPARING
  FRAMING
  CAPTIONING
  RENDERING
  READY
  FAILED
}

model Clip {
  id            String       @id @default(cuid())
  videoId       String
  momentId      String?
  userId        String
  title         String
  hook          String?      @db.Text
  status        ClipStatus   @default(DRAFT)
  /// Trim range relative to the moment, in ms. Defaults to the full moment.
  trimStartMs   Int          @default(0)
  trimEndMs     Int?
  startMs       Int
  endMs         Int
  aspectRatio   AspectRatio  @default(RATIO_9_16)
  width         Int          @default(1080)
  height        Int          @default(1920)
  reframeMode   ReframeMode  @default(AUTO)
  /// Keyframed crop path: [{t, x, y, w, h}] in normalised coords.
  cropPath      Json?
  captionStyle  CaptionStyle @default(CREATOR)
  captionFont   String       @default("Montserrat Bold")
  captionSize   Int          @default(64)
  captionPositionY Float     @default(0.78)
  captionUppercase Boolean   @default(true)
  captionHighlightWords String[] @default([])
  captionPrimaryColor String @default("#FFFFFF")
  captionAccentColor  String @default("#FACC15")
  captionBackground   String?
  captionAnimation    Boolean @default(true)
  muted          Boolean     @default(false)
  volume         Float       @default(1)
  musicKey       String?
  musicVolume    Float       @default(0.18)
  watermarkKey   String?
  watermarkText  String?
  /// Optional LongCat-generated B-roll inserts: [{startMs,endMs,storageKey,prompt}]
  brollInserts   Json?
  storageKey     String?
  thumbKey       String?
  previewKey     String?
  sizeBytes      BigInt?
  durationMs     Int?
  errorMessage   String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  video   Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  moment  Moment?     @relation(fields: [momentId], references: [id], onDelete: SetNull)
  captions Caption[]
  renders RenderJob[]
  exports Export[]
  publications Publication[]

  @@index([videoId, createdAt])
  @@index([userId, status])
  @@index([momentId])
}

model Caption {
  id        String   @id @default(cuid())
  clipId    String
  index     Int
  startMs   Int
  endMs   Int
  text      String
  /// Per-word highlight timing for karaoke styles: [{w, s, e}].
  words     Json?
  speakerId String?
  createdAt DateTime @default(now())

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId, index])
  @@index([speakerId])
}

enum RenderStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model RenderJob {
  id         String       @id @default(cuid())
  clipId     String
  jobId      String?      @unique
  status     RenderStatus @default(QUEUED)
  progress   Int          @default(0)
  /// Snapshot of every render input, so a render is reproducible.
  params     Json?
  worker     String?
  /// Which worker class executed it: "cpu" | "gpu".
  workerKind String?
  gpuUsed    Boolean      @default(false)
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([clipId, createdAt])
  @@index([status])
}

enum ExportPlatform {
  TIKTOK
  YOUTUBE_SHORTS
  INSTAGRAM_REELS
  YOUTUBE
  LINKEDIN
  CUSTOM
}

model Export {
  id          String         @id @default(cuid())
  clipId      String
  userId      String
  platform    ExportPlatform
  aspectRatio AspectRatio    @default(RATIO_9_16)
  resolution  String?
  storageKey  String?
  downloadKey String?
  /// Signed-URL expiry, so the UI never caches an expired link.
  expiresAt   DateTime?
  sizeBytes   BigInt?
  status      RenderStatus   @default(QUEUED)
  error       String?        @db.Text
  createdAt   DateTime       @default(now())

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clipId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Billing-ready: usage + subscription
// ---------------------------------------------------------------------------

enum UsageMetric {
  VIDEO_INGESTED
  MINUTE_TRANSCRIBED
  MOMENT_ANALYZED
  CLIP_GENERATED
  CLIP_RENDERED
  EXPORT_CREATED
  BROLL_SECOND
  /// Seconds of text-to-video generation consumed.
  VIDEO_GENERATED
  /// One successful publish to a social platform.
  CLIP_PUBLISHED
}

model Usage {
  id        String      @id @default(cuid())
  userId    String
  metric    UsageMetric
  quantity  Int         @default(1)
  /// Rolling period bucket, e.g. "2026-10" — cheap monthly aggregation.
  period    String
  videoId   String?
  clipId    String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, metric, period])
  @@index([videoId])
  @@index([clipId])
}

enum PlanTier {
  FREE
  CREATOR
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  /// Set once a real gateway (Stripe/Paystack) is wired up.
  provider             String?
  providerCustomerId   String?
  providerSubId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier, status])
  @@index([providerCustomerId])
  @@index([providerSubId])
}

// ---------------------------------------------------------------------------
// Social publishing: connected accounts + publish jobs
//
// Tokens are stored encrypted at rest (see lib/publishing/crypto.ts). A user may
// connect several accounts per platform; publishing always names an accountId so
// ownership is explicit and never inferred.
// ---------------------------------------------------------------------------

enum SocialPlatform {
  YOUTUBE
  TIKTOK
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
}

enum SocialAccountStatus {
  CONNECTED
  /// The stored token expired and could not be refreshed.
  EXPIRED
  /// The user revoked access, or the platform rejected the token.
  REVOKED
}

model SocialAccount {
  id             String              @id @default(cuid())
  userId         String
  platform       SocialPlatform
  /// Platform-side user/channel/page id. Unique per (platform, platformUserId).
  /// Platform-side user/channel/page id. Unique per (user, platform, id) — an
  /// agency and a channel owner may both connect the same channel.
  platformUserId String
  username       String?
  displayName    String?
  avatarUrl      String?              @db.Text
  /// Encrypted at rest. Never returned to the browser.
  accessToken    String               @db.Text
  refreshToken   String?              @db.Text
  tokenType      String?
  scopes         String[]
  /// When accessToken stops being valid; drives proactive refresh.
  expiresAt      DateTime?
  status         SocialAccountStatus @default(CONNECTED)
  /// Raw platform payload (channel/page metadata, quotas, ...) for diagnostics.
  meta           Json?
  connectedAt    DateTime            @default(now())
  lastUsedAt     DateTime?
  lastError      String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@unique([userId, platform, platformUserId])
  @@index([userId, platform])
  @@index([platform, platformUserId])
  @@index([status])
}

enum PublishStatus {
  QUEUED
  UPLOADING
  /// Uploaded and processing on the platform (YouTube transcodes before it is live).
  PROCESSING
  PUBLISHED
  SCHEDULED
  FAILED
}

enum PublishPrivacy {
  PUBLIC
  UNLISTED
  PRIVATE
}

/// One attempt to publish one clip to one connected account.
model Publication {
  id           String          @id @default(cuid())
  clipId       String
  userId       String
  accountId    String
  platform     SocialPlatform
  title        String
  description  String?         @db.Text
  tags         String[]
  privacy      PublishPrivacy  @default(PUBLIC)
  /// Per-platform extras (playlistId, categoryId, allowComments, duet/stitch, ...)
  options      Json?
  status       PublishStatus   @default(QUEUED)
  /// Set for SCHEDULED; the worker defers until this time.
  scheduledFor DateTime?
  /// Ids/URLs returned by the platform once the post exists.
  platformPostId String?
  platformUrl    String?       @db.Text
  publishedAt  DateTime?
  attempts     Int             @default(0)
  /// User-facing failure reason. Raw platform errors go to the server log.
  error        String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  clip    Clip          @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([clipId])
  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([status, scheduledFor])
  @@index([platformPostId])
}
