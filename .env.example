# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://viralcut:viralcut@localhost:5432/viralcut

# ── Redis (BullMQ queues + SSE pub/sub) ─────────────────────────────────
REDIS_URL=redis://localhost:6379
# QUEUE_DRIVER=redis|inline   (defaults to redis when REDIS_URL is set)

# ── Auth (NextAuth) ─────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Object storage (Cloudflare R2, S3-compatible) ───────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=viralcut-media
R2_PUBLIC_URL=https://media.your-domain.com
# For local development you can skip R2 and use the local filesystem backend:
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=./.media

# ── AI provider (OpenAI-compatible: OpenAI, OpenRouter, Groq, etc.) ─────
AI_API_KEY=your-ai-api-key
VIRALCUT_AI_PROVIDER=openai
VIRALCUT_AI_MODEL=gpt-4o-mini
# VIRALCUT_AI_BASE_URL=https://api.openai.com/v1

# ── Frontend → media engine ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
FASTAPI_URL=http://localhost:8000
MEDIA_ENGINE_TOKEN=replace-with-a-long-random-token
VIRALCUT_CALLBACK_BASE_URL=http://localhost:3000
VIRALCUT_CALLBACK_TOKEN=replace-with-a-long-random-token

# ── Media engine internals ──────────────────────────────────────────────
FFMPEG_PATH=/usr/bin/ffmpeg
MEDIA_WORK_DIR=/tmp/viralcut-work
FASTAPI_PORT=8000
# Whisper / diarization (optional — falls back to CPU / disabled if unset)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PYANNOTE_HF_TOKEN=

# ── LongCat-Video (optional GPU worker: B-roll + text-to-video) ─────────
LONGCAT_ENABLED=false
LONGCAT_API_URL=http://localhost:8001
LONGCAT_WORKER_TOKEN=replace-with-a-long-random-token

# ── Text-to-video ───────────────────────────────────────────────────────
# Which backend produces prompt->video. One of:
#   longcat | fal | replicate | luma | runway | none
# Leave as "none" and the UI says so plainly instead of pretending to generate.
VIRALCUT_T2V_PROVIDER=none
# Backend-specific model (fal slug, Replicate "owner/name", luma "ray-2", ...)
VIRALCUT_T2V_MODEL=
VIRALCUT_T2V_MAX_SECONDS=10
VIRALCUT_T2V_TIMEOUT_SECONDS=900
# Only the key for the provider you selected is needed:
FAL_KEY=
REPLICATE_API_TOKEN=
LUMA_API_KEY=
RUNWAY_API_KEY=

# ── Social publishing ───────────────────────────────────────────────────
# Encrypts stored access/refresh tokens at rest. Falls back to NEXTAUTH_SECRET
# if unset, but a dedicated key is recommended.
SOCIAL_TOKEN_KEY=replace-with-a-long-random-string

# YouTube: a Google Cloud OAuth client with the YouTube Data API v3 enabled.
# Reuses GOOGLE_CLIENT_ID/SECRET above unless overridden here.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok: developer app with the Content Posting API product (audit required
# for public posting).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Facebook + Instagram share one Meta app. Instagram additionally needs a Page
# whose linked Instagram account is Business or Creator.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v21.0

# LinkedIn: app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202405

# X: app with OAuth 2.0 user context enabled (PKCE).
X_CLIENT_ID=
X_CLIENT_SECRET=
